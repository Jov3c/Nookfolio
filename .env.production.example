POSTGRES_DB=nookfolio
POSTGRES_USER=nookfolio
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://nookfolio:replace-with-a-long-random-password@postgres:5432/nookfolio?schema=public
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_DISPLAY_NAME=Nookfolio
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Nookfolio
SMTP_FROM_EMAIL=
PUBLIC_SITE_URL=https://localhost
# Set alternate values (for example, 8080 and 8443) when 80/443 are used by another local project.
NOOKFOLIO_HTTP_PORT=80
NOOKFOLIO_HTTPS_PORT=443
NOOKFOLIO_SERVER_NAME=localhost
NOOKFOLIO_DATA_ROOT=/srv/nookfolio/data
NOOKFOLIO_TLS_ROOT=/srv/nookfolio/tls
